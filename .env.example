# Local development defaults. Copy to .env and replace secrets before use.
DATABASE_URL=postgresql+psycopg://thoughtharbor:thoughtharbor@localhost:5432/thoughtharbor
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=.data/files
# Required for AI features. Keep this server-side and out of frontend variables.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDINGS_MODEL=openai/text-embedding-3-small
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_CACHE=.data/models/whisper
DIARIZATION_ENABLED=false
DIARIZATION_PROVIDER=pyannote
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=cpu
DIARIZATION_MODEL_CACHE=.data/models/diarization
CLASSIFICATION_AUTO_ACCEPT_THRESHOLD=0.85
# Required only when DIARIZATION_ENABLED=true; keep this local secret out of git.
HUGGINGFACE_TOKEN=
PUBLIC_API_BASE_URL=http://localhost:8000
TH_ENVIRONMENT=development
SESSION_SECRET=replace-with-a-long-random-local-development-secret
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional read-only MCP client identity; set both values before connecting.
MCP_API_TOKEN=
MCP_OWNER_ID=
MCP_WRITE_ENABLED=false
LOG_LEVEL=INFO
