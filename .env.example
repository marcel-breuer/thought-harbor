# Local development defaults. Copy to .env and replace secrets before use.
DATABASE_URL=postgresql+psycopg://thoughtharbor:thoughtharbor@localhost:5432/thoughtharbor
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=.data/files
OLLAMA_BASE_URL=http://localhost:11434
# Ollama is the default local provider. Set a capability provider to
# openai_compatible only when explicitly opting into another endpoint.
AI_DEFAULT_PROVIDER=ollama
AI_CHAT_MODEL=llama3.2:3b
AI_EXTRACTION_MODEL=llama3.2:3b
AI_EMBEDDINGS_MODEL=nomic-embed-text
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_CACHE=.data/models/whisper
DIARIZATION_ENABLED=false
DIARIZATION_PROVIDER=pyannote
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=cpu
DIARIZATION_MODEL_CACHE=.data/models/diarization
CLASSIFICATION_AUTO_ACCEPT_THRESHOLD=0.85
# Required only when DIARIZATION_ENABLED=true; keep this local secret out of git.
HUGGINGFACE_TOKEN=
# Example external opt-in (keep keys server-side; do not put them in the web app):
# AI_CHAT_PROVIDER=openai_compatible
# AI_CHAT_BASE_URL=https://your-openai-compatible-endpoint/v1
# AI_CHAT_API_KEY=replace-me
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
SESSION_SECRET=replace-with-a-long-random-local-development-secret
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
